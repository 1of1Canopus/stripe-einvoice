<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.housedevinci</groupId>
    <artifactId>stripe-einvoice-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>stripe-einvoice-core</artifactId>
  <name>Stripe E-Invoice :: Core</name>
  <description>Framework-free domain and application layer: the EN 16931 model, the legal numbering series and its allocator, the issuance state machine and the hash-chained issuance log. JDK only, plus SLF4J: no Spring, no JPA, no Stripe SDK, no crypto library (HMAC-SHA-256 and SHA-256 come from the JDK).</description>

  <dependencies>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <!--
      Optional, and the artifact is useless to a host that does not archive to S3. The S3 adapter
      is the only class that touches it, the starter wires it @ConditionalOnClass, and a host that
      archives to a filesystem never sees the transitive tree. The Netty and Apache HTTP clients
      are excluded: one sync client is what a conditional PUT needs, and the other two are several
      megabytes of transitive surface for nothing.
    -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <optional>true</optional>
      <exclusions>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>netty-nio-client</artifactId>
        </exclusion>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>apache-client</artifactId>
        </exclusion>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>apache5-client</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>url-connection-client</artifactId>
      <optional>true</optional>
    </dependency>
    <!--
      Optional for the same reason: a host that supplies its own StripeInvoiceSource takes no SDK
      at all. The signature check is ours (WebhookSignature) and needs nothing from it.
    -->
    <dependency>
      <groupId>com.stripe</groupId>
      <artifactId>stripe-java</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      The XSLT 2.0 processor the official EN 16931, XRechnung and Peppol schematron are written
      in, and the one this module ships with. RUNTIME scope: it is needed to validate a document
      and by nothing at compile time, so no code here may import a Saxon type - the processor is
      still reached through JAXP by class name (see SecureXml), which is what lets a host
      substitute its own.

      Saxon-HE is MPL-2.0. The licence gate denies MPL, with one coordinate-scoped exception for
      exactly this artifact, decided by the maintainer and recorded in
      tools/check-third-party-licences.sh (ALLOWED_COORDINATE_LICENCES) with the invariant that
      makes it safe. A second MPL dependency still fails the gate. Before this, a default install
      could validate nothing, therefore issue nothing, and every host had to add this dependency
      itself after reading the README - a documented cliff rather than a working library.
    -->
    <dependency>
      <groupId>net.sf.saxon</groupId>
      <artifactId>Saxon-HE</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-minio</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      H2 is here for one test and one only: the PostgreSQL probe has to be shown refusing a server
      that is not PostgreSQL, and a refusal nobody ever watched happen is a refusal nobody knows
      works. Nothing in main code supports H2 and nothing should.
    -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!--
    L2 (sibling module): the JaCoCo prepare-agent/report/check executions live once, in the parent
    POM's <build><plugins>, so core, the starter and the sample all produce a jacoco.csv and all run
    the check - a starter whose startup refusals and auto-configuration are unmeasured is the shape
    that defect took there. See stripe-einvoice-sample/pom.xml for why the sample's gate is a smoke
    gate rather than the same 85% minimum.
  -->

  <build>
    <!--
      Same fix as agent-guard's M7:
      the project's own LICENSE and NOTICE, copied into META-INF/ of the published jar.
      FSL-1.1-ALv2's Redistribution clause requires a copy of (or a link to) the Terms and
      Conditions to accompany redistributed copies; NOTICE travels with it by the same
      convention Apache-2.0 SS4(d) used. This is a separate concern from the deferred
      THIRD-PARTY-NOTICES.txt embedding.
    -->
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>${maven.multiModuleProjectDirectory}</directory>
        <targetPath>META-INF</targetPath>
        <includes>
          <include>LICENSE</include>
          <include>NOTICE</include>
        </includes>
      </resource>
    </resources>
  </build>
</project>
